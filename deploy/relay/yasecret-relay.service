# Always-on Yasecret peer as a systemd service.
#   sudo cp target/release/yasecret /usr/local/bin/
#   sudo cp deploy/relay/yasecret-relay.service /etc/systemd/system/
#   sudo systemctl enable --now yasecret-relay
#   sudo YASECRET_RELAY_DIR=/var/lib/yasecret-relay yasecret relay code
#   sudo YASECRET_RELAY_DIR=/var/lib/yasecret-relay yasecret relay add '<link from Yasecret>'
[Unit]
Description=Yasecret always-on peer
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/yasecret relay
Environment=YASECRET_RELAY_DIR=/var/lib/yasecret-relay
StateDirectory=yasecret-relay
StateDirectoryMode=0700
DynamicUser=yes
Restart=always
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes

[Install]
WantedBy=multi-user.target
